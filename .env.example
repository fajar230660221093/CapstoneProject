# =====================================================================
# Variabel lingkungan SIM Karang Taruna Dusun Tagog
# Salin file ini menjadi .env.local lalu isi nilainya.
# Ambil nilainya dari Supabase Dashboard > Project Settings > API.
# =====================================================================

# URL project Supabase (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (anon key versi baru). AMAN dipakai di browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dipakai HANYA oleh skrip backup di GitHub Actions (JANGAN pernah di-commit
# dan jangan pernah dipakai di kode aplikasi).
SUPABASE_SERVICE_ROLE_KEY=

# Password database Postgres (untuk pg_dump) - hanya di GitHub Secrets.
SUPABASE_DB_PASSWORD=

# Host pooler untuk pg_dump. Contoh: aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres

# Project Supabase kedua yang dipakai sebagai "lemari cadangan".
BACKUP_SUPABASE_URL=
BACKUP_SUPABASE_SERVICE_ROLE_KEY=
BACKUP_BUCKET_NAME=backups

# URL aplikasi produksi (untuk tautan bagikan & ping health check)
NEXT_PUBLIC_APP_URL=http://localhost:3000
